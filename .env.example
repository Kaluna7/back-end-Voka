PORT=5000
MONGODB_URI=mongodb://localhost:27017/Moocha

# Redis — hot window for last N chat turns (DeepSeek prompt-cache friendly)
REDIS_URL=redis://127.0.0.1:6379
CHAT_HISTORY_CACHE_LIMIT=20
CHAT_HISTORY_TTL_SECONDS=604800
REDIS_CONNECT_TIMEOUT_MS=2000

# Keep API keys only in backend
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_VOICE_MODEL=deepseek-v4-flash

DEEPGRAM_API_KEY=your_deepgram_api_key_here
# us = api.deepgram.com (default, more stable on mobile hotspot). eu = api.eu.deepgram.com
DEEPGRAM_REGION=us
DEEPGRAM_MODEL=flux-general-multi
DEEPGRAM_LANGUAGE=multi
DEEPGRAM_STREAM_MODEL=nova-3
DEEPGRAM_STREAM_LANGUAGE=multi
DEEPGRAM_ENDPOINTING_MS=500
DEEPGRAM_UTTERANCE_END_MS=1000
STORY_RUSH_DEEPGRAM_ENDPOINTING_MS=120
DEEPGRAM_LIVE_WS_URL=wss://api.deepgram.com/v1/listen
# Voice orchestration: deepgram-agent (native STT/EOT/TTS) or legacy (RealtimeTurnEngine)
VOICE_PROVIDER=deepgram-agent
# Public HTTPS base Deepgram can reach (ngrok/cloudflared/production). Required for deepgram-agent.
# Example: https://abc123.ngrok-free.app
# Leave empty + VOICE_AGENT_AUTO_TUNNEL=true to spawn ngrok on backend start.
VOICE_AGENT_PUBLIC_BASE_URL=
VOICE_AGENT_AUTO_TUNNEL=true
# Or full think URL (OpenAI-compatible). Overrides PUBLIC_BASE_URL path.
# VOICE_AGENT_THINK_URL=https://abc123.ngrok-free.app/api/internal/voice-agent/chat/completions
VOICE_AGENT_THINK_SECRET=change-me-voice-agent-think-secret
VOICE_AGENT_LISTEN_MODEL=flux-general-en
VOICE_AGENT_EOT_THRESHOLD=0.7
VOICE_AGENT_EAGER_EOT_THRESHOLD=0.5
VOICE_AGENT_EOT_TIMEOUT_MS=3000
VOICE_AGENT_OUTPUT_SAMPLE_RATE=24000
VOICE_AI_MIN_TRIGGER_WORDS=3
VOICE_AI_EMPTY_TRANSCRIPT_FALLBACK=Hello?
VOICE_AI_START_ON_PARTIAL=false
VOICE_AI_START_ON_TRANSCRIPT_SILENCE=false
VOICE_AI_EARLY_TTS=false
VOICE_AI_FILLER=false
VOICE_AI_FILLER_TEXT=Okay.
VOICE_AI_TTS_CONCURRENCY=1
# quality-first: linear16 PCM WAV (uncompressed). Set opus for lower bandwidth.
DEEPGRAM_TTS_ENCODING=linear16
DEEPGRAM_TTS_SAMPLE_RATE=24000
DEEPGRAM_TTS_OPUS_BIT_RATE=64000
DEEPGRAM_TTS_MIN_CHUNK_BYTES=2048
VOICE_AI_REALTIME_TTS_ENCODING=mp3
VOICE_AI_MAX_TTS_SENTENCES=4
VOICE_AI_MAX_TTS_JOBS=4
VOICE_AI_TTS_STREAM_FIRST_SENTENCE=true
VOICE_AI_OPENER_MIN_WORDS=2
VOICE_AI_OPENER_MAX_WORDS=8
VOICE_AI_MIN_TTS_WORDS=1
VOICE_AI_TTS_PHRASE_BATCH=true
VOICE_AI_TTS_PHRASE_BATCH_SENTENCE_LIMIT=2
VOICE_AI_TTS_PHRASE_BATCH_MAX_WAIT_MS=80
DEEPSEEK_VOICE_TIMEOUT_MS=3500
DEEPSEEK_VOICE_HISTORY_LIMIT=4
DEEPSEEK_VOICE_MAX_TOKENS=72
VOICE_AI_STABLE_PARTIAL_MS=500
VOICE_AI_SILENCE_TRIGGER_MS=500
VOICE_AI_STT_FINALIZE_MS=0
VOICE_AI_INCOMPLETE_INPUT_FINALIZE_MS=600
VOICE_INPUT_EMPTY_TRANSCRIPT_GRACE_MS=300
VOICE_AI_TRIGGER_DEBOUNCE_MS=450
VOICE_AI_TRIGGER_DEBOUNCE_FINAL_MS=80
VOICE_AI_EARLY_TTS_CHARS=12
DEEPGRAM_REALTIME_STT=true
DEEPGRAM_STREAM_REST_FALLBACK=true
DEEPGRAM_STREAM_REST_FALLBACK_TIMEOUT_MS=10000
DEEPGRAM_STREAM_CONNECT_TIMEOUT_MS=5000
DEEPGRAM_STT_TIMEOUT_MS=10000
DEEPGRAM_TTS_TIMEOUT_MS=12000
DEEPGRAM_TTS_FAILOVER_TIMEOUT_MS=800
DEEPGRAM_TTS_FALLBACK_TIMEOUT_MS=2500
DEEPGRAM_TTS_WS_CONNECT_TIMEOUT_MS=800
DEEPGRAM_TTS_WS_ALT_CONNECT_TIMEOUT_MS=1800
DEEPGRAM_CONNECT_TIMEOUT_MS=2000
DEEPGRAM_FAILOVER_TIMEOUT_MS=3500
DEEPGRAM_FORCE_IPV4=true
DEEPGRAM_UNAVAILABLE_BACKOFF_MS=30000
DEEPGRAM_TTS_MIN_CHUNK_BYTES=1024
VOICE_AI_TTS_CONCURRENCY=1

# Google OAuth 2 — Web Client ID (sama dengan GOOGLE_OAUTH_WEB_CLIENT_ID di app)
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Google Cloud TTS for Korean, Arabic, Chinese (Deepgram has no Aura voices)
GOOGLE_TTS_CREDENTIALS_PATH=secrets/google-tts-credentials.json

# Email — Hostinger SMTP (gunakan kutip jika password mengandung #)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-mailbox@no-reply-information.tech
SMTP_PASS="your_mailbox_password"
SMTP_SENDER_EMAIL=your-mailbox@no-reply-information.tech
SMTP_SENDER_NAME=Moocha

# Voice Tokens (call quota). Plans: config/voicePlans.js — Basic 100K, Pro 300K, Premium 1M / month.
# Token cost = (STT minutes * VOICE_STT_IDR_PER_MINUTE + TTS chars/1000 * VOICE_TTS_IDR_PER_1K_CHARS) / VOICE_TOKEN_IDR
VOICE_STT_IDR_PER_MINUTE=130
VOICE_TTS_IDR_PER_1K_CHARS=500
VOICE_TOKEN_IDR=0.2
VOICE_TYPICAL_TTS_CHARS_PER_MINUTE=400
# Dev only: skip balance checks and charging.
VOICE_TOKENS_UNLIMITED=false

# Google Play Billing (subscriptions)
GOOGLE_PLAY_PACKAGE_NAME=com.moocha
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=secrets/google-play-service-account.json
GOOGLE_PLAY_PRODUCT_BASIC=moocha_basic_monthly
GOOGLE_PLAY_PRODUCT_PRO=moocha_pro_monthly
GOOGLE_PLAY_PRODUCT_PREMIUM=moocha_premium_monthly
# Shared secret appended to the Pub/Sub push URL (?token=...)
GOOGLE_PLAY_RTDN_TOKEN=change-me
# Dev only: allow /subscription/activate without a Play purchase. Must be false in production.
BILLING_ALLOW_UNVERIFIED=false

# Free voice tokens for every new account (8250 = about 5 minutes of calls)
WELCOME_VOICE_TOKENS=8250

# Security
# Signs login tokens (at least 32 random characters). Changing it logs every user out.
AUTH_SIGNING_SECRET=change-me-to-a-long-random-string
# Comma-separated browser origins allowed by CORS (the mobile app needs none)
CORS_ORIGINS=
# Set when running behind a reverse proxy, e.g. 1
TRUST_PROXY=
# Bind address. Use 127.0.0.1 in production behind Caddy/Nginx so only the proxy can reach the app.
HOST=0.0.0.0
